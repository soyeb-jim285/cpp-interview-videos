     "code": "int partition(vector<int>& a, int lo, int hi) {\n    int pivot = a[hi], i = lo;\n    for (int j = lo; j < hi; j++)\n        if (a[j] < pivot) swap(a[i++], a[j]);\n    swap(a[i], a[hi]);\n    return i;\n}"
