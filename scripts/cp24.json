    {
     "file": "sol.cpp",
     "code": "Node* reverse(Node* head) {\n    Node* prev = nullptr;\n    while (head) {\n        Node* nxt = head->next;\n        head->next = prev;\n        prev = head;\n        head = nxt;\n    }\n    return prev;\n}"
    }
