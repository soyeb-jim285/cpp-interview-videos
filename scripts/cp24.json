   "panels": [
    {
     "file": "sol.cpp",
     "code": "Node* mergeLists(Node* a, Node* b) {\n    Node dummy{0, nullptr};\n    Node* tail = &dummy;\n    while (a && b) {\n        if (a->val <= b->val) {\n            tail->next = a; a = a->next;\n        } else {\n            tail->next = b; b = b->next;\n        }\n        tail = tail->next;\n    }\n    tail->next = a ? a : b;\n    return dummy.next;\n}"
    }
   ],
