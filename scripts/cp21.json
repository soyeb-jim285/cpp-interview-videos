  {
   "type": "code",
   "head": "Merge sort in C plus plus",
   "panels": [
    {
     "file": "sol.cpp",
     "code": "void mergeSort(vector<int>& a, int l, int r) {  // sorts [l, r)\n    if (r - l < 2) return;\n    int m = (l + r) / 2;\n    mergeSort(a, l, m);\n    mergeSort(a, m, r);\n    vector<int> t;\n    int i = l, j = m;\n    while (i < m || j < r) {\n        if (j == r || (i < m && a[i] <= a[j]))\n            t.push_back(a[i++]);\n        else t.push_back(a[j++]);\n    }\n    copy(t.begin(), t.end(), a.begin() + l);\n}"
    }
   ],
   "steps": [
    {
     "cue": "Sort the left half",
     "lines": [
      3,
      4,
      5
     ]
    },
