  {
   "type": "code",
   "head": "The same idea in code",
   "panels": [
    {
     "file": "sol.cpp",
     "code": "int maxSum(const vector<int>& a, int k) {\n    int cur = 0, best = INT_MIN;\n    for (int i = 0; i < (int)a.size(); i++) {\n        cur += a[i];                  // new one enters\n        if (i >= k) cur -= a[i - k];  // old one leaves\n        if (i >= k - 1) best = max(best, cur);\n    }\n    return best;\n}"
    }
   ],
   "steps": [
    {
     "cue": "adds the element",
     "lines": [
      4
     ]
