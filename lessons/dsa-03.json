    {
     "type": "code",
     "head": "Two pointers in code",
     "say": "Here it is in C plus plus. L at the start, R at the last index. Keep going while L is less than R. Add the two ends. Equal to the target? Done. Too small, L moves right. Otherwise R moves left. Each step throws one index away, so it's at most n steps. On our array it prints true, and for a hundred, false.",
     "panels": [
      {
       "file": "sol.cpp",
       "code": "bool pairSum(const vector<int>& a, int t) {\n    int l = 0, r = (int)a.size() - 1;\n    while (l < r) {\n        int s = a[l] + a[r];\n        if (s == t) return true;\n        if (s < t) l++; else r--;\n    }\n    return false;\n}"
      }
     ],
     "steps": [
      {
       "lines": [
        2
       ],
       "cue": "L at the start"
      },
      {
       "lines": [
        3
       ],
       "cue": "while L is less"
      },
      {
       "lines": [
        4
       ],
       "cue": "Add the two ends"
      },
      {
       "lines": [
        5
       ],
       "cue": "Equal to the target"
      },
      {
       "lines": [
        6
       ],
       "cue": "Too small"
      }
     ],
     "notes": [
      {
       "line": 6,
       "inside": true,
       "text": "O(n) time, O(1) memory",
       "tone": "good",
       "cue": "throws one index away"
      }
     ],
     "output": {
      "cmd": "./sol",
      "text": "true\nfalse",
      "cue": "prints true"
     }
