       "code": "int longest(const string& s) {\n    int cnt[256] = {}, l = 0, best = 0;\n    for (int r = 0; r < (int)s.size(); r++) {\n        cnt[(uint8_t)s[r]]++;\n        while (cnt[(uint8_t)s[r]] > 1) cnt[(uint8_t)s[l++]]--;\n        best = max(best, r - l + 1);\n    }\n    return best;\n}"
