      },
      {
       "lines": [
        5
       ],
       "cue": "subtract the element"
      },
      {
       "lines": [
        6
       ],
       "cue": "record the best"
      }
     ],
     "notes": [
      {
       "line": 2,
       "inside": true,
       "text": "INT_MIN: negatives are fine",
       "tone": "good",
