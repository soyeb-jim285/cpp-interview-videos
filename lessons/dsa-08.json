       "file": "sol.cpp",
       "code": "struct Trie {\n    Trie* kid[26] = {};\n    bool end = false;\n    void insert(const string& w) {\n        Trie* u = this;\n        for (char ch : w) {\n            int c = ch - 'a';\n            if (!u->kid[c]) u->kid[c] = new Trie();\n            u = u->kid[c];\n        }\n        u->end = true;\n    }"
