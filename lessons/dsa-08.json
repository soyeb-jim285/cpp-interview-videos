      },
      {
       "file": "sol.cpp",
       "label": "fixed",
       "tone": "good",
       "code": "void walk(Node* n) {\n    if (!n) return;\n    walk(n->left);\n    cout << n->val << ' ';\n    walk(n->right);\n}"
      }
