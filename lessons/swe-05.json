    {
     "type": "quiz",
     "say": "Your turn. Now a hundred commits, with only the first and last known. In the worst case, how many tests does bisect need? Pause and predict.",
     "q": "100 commits, bug somewhere. Worst-case bisect tests?",
     "options": [
      "7",
      "10",
      "50",
      "98"
     ],
     "answer": 0
    },
    {
     "type": "code",
     "head": "Let git do the halving",
     "say": "Seven. Two to the seventh is one twenty eight, more than a hundred. Tell git the current commit is bad, and the one ninety nine back is good. Bisect run feeds it a test script. Exit zero means good. It ran seven tests, and names the culprit.",
     "panels": [
      {
       "file": "run.sh",
       "code": "git bisect start\ngit bisect bad HEAD\ngit bisect good HEAD~99\ngit bisect run ./test.sh | grep -c running\ngit log -1 --format=%s refs/bisect/bad\ngit bisect reset"
      }
     ],
     "steps": [
      {
       "lines": [
        1
       ],
       "cue": "Tell git"
      },
      {
       "lines": [
        2
       ],
       "cue": "current commit is bad"
      },
      {
       "lines": [
        3
       ],
       "cue": "ninety nine back"
      },
      {
       "lines": [
        4
       ],
       "cue": "Bisect run"
      },
      {
       "lines": [
        4
       ],
       "cue": "Exit zero"
      },
      {
       "lines": [
        5
       ],
       "cue": "names the culprit"
      }
     ],
     "output": {
      "cmd": "sh run.sh",
      "text": "7\norder id from seconds",
      "cue": "It ran seven"
     }
    }
