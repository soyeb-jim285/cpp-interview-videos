   "title": "Halve the history",
   "scenes": [
    {
     "type": "hook",
     "say": "A build broke somewhere in the last hundred commits. By the end, you'll find the culprit in seven tries, then tell that hunt as a story that lands the offer.",
     "lines": [
      {
       "text": "100 commits. One broke it.",
       "cue": "hundred commits"
      },
      {
       "text": "Found in 7 tries.",
       "cue": "seven tries"
      },
      {
       "text": "Then tell it well.",
       "cue": "tell that hunt",
       "accent": true
      }
     ]
    },
    {
     "type": "flow",
     "head": "A detective, not a gambler",
     "say": "Interviewers test your method, not your luck. A detective doesn't guess. First, reproduce: make it fail on demand. Second, minimize: shrink the failing input. Third, bisect: halve the history. Fourth, fix it, and add a test.",
     "items": [
      {
       "label": "one",
       "text": "Reproduce",
       "sub": "fail on demand",
       "cue": "First, reproduce"
      },
      {
       "label": "two",
