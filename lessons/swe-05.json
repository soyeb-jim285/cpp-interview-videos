   "title": "Reproduce, then shrink",
   "scenes": [
    {
     "type": "code",
     "head": "Shrink the input by halves",
     "say": "A job fails on a file with ten thousand rows. Don't read them all. Keep the first five thousand: still fails. The first three: passes. The first four: fails. So row four is the culprit, and you hold a tiny repro that becomes your regression test.",
     "panels": [
      {
       "file": "shrink.py",
       "code": "rows = [\"ok\"] * 10000\nrows[3] = \"\"\ndef fails(r):\n    return \"\" in r\nprint(fails(rows[:5000]), fails(rows[:3]), fails(rows[:4]))"
      }
     ],
     "steps": [
