       "lines": [
        6,
        7
       ],
       "cue": "Mark it used"
      },
      {
       "lines": [
        8
       ],
       "cue": "recurse"
      },
      {
       "lines": [
        9,
        10
       ],
       "cue": "undo both"
      }
     ],
