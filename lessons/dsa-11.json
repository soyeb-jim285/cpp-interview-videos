    {
     "type": "code",
     "head": "Permutations: any unused item",
     "say": "Now the code. When cur is as long as a, save it. Otherwise try every item, not only later ones, but skip used ones. Mark it used, push it, recurse. Then undo both. That's n factorial leaves, and copying each costs n: O of n times n factorial.",
     "panels": [
      {
       "file": "sol.cpp",
       "code": "void perm(vector<int>& a, vector<int>& cur,\n          vector<bool>& used, vector<vector<int>>& res) {\n    if (cur.size() == a.size()) { res.push_back(cur); return; }\n    for (int i = 0; i < (int)a.size(); i++) {\n        if (used[i]) continue;\n        used[i] = true;\n        cur.push_back(a[i]);\n        perm(a, cur, used, res);\n        cur.pop_back();\n        used[i] = false;\n    }\n}"
      }
     ],
     "steps": [
      {
       "lines": [
        3
       ],
       "cue": "save it"
      },
