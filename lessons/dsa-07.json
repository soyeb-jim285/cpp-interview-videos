    {
     "type": "code",
     "head": "nextGreater",
     "say": "Here's the code. The result starts at minus one, for items never beaten. The stack holds indices. While the top item is smaller than the newcomer, pop it and record the newcomer as its answer. Then push the newcomer. The stack stays in decreasing order: a monotonic stack.",
     "panels": [
      {
       "file": "sol.cpp",
       "code": "vector<int> nextGreater(vector<int>& a) {\n    vector<int> res(a.size(), -1);\n    stack<int> st;\n    for (int i = 0; i < (int)a.size(); i++) {\n        while (!st.empty() && a[st.top()] < a[i]) {\n            res[st.top()] = a[i];\n            st.pop();\n        }\n        st.push(i);\n    }\n    return res;\n}"
      }
     ],
     "steps": [
      {
       "lines": [
        2
       ],
       "cue": "starts at minus one"
      },
      {
       "lines": [
        3
       ],
       "cue": "holds indices"
      },
      {
       "lines": [
        5
       ],
       "cue": "While the top item"
      },
      {
       "lines": [
        6,
        7
       ],
       "cue": "pop it and record"
      },
      {
       "lines": [
        9
       ],
       "cue": "Then push"
      },
      {
       "lines": [],
       "cue": "a monotonic stack"
      }
     ]
