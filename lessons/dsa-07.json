    {
     "type": "code",
     "head": "Valid brackets",
     "say": "In code, push every opener. On a closer, the stack must not be empty, and its top must be the partner. Then pop. If the loop ends with an empty stack, it's valid.",
     "panels": [
      {
       "file": "sol.cpp",
       "code": "bool valid(const string& s) {\n    string open = \"([{\", close = \")]}\";\n    stack<char> st;\n    for (char c : s) {\n        if (open.find(c) != string::npos) { st.push(c); continue; }\n        if (st.empty()) return false;\n        if (open.find(st.top()) != close.find(c)) return false;\n        st.pop();\n    }\n    return st.empty();\n}"
      }
     ],
     "steps": [
