       "sol.cpp": "#include <bits/stdc++.h>\nusing namespace std;\nvector<int> nextGreater(vector<int>& a) {\n    vector<int> res(a.size(), -1);\n    stack<int> st;\n    for (int i = 0; i < (int)a.size(); i++) {\n        while (!st.empty() && a[st.top()] < a[i]) {\n            res[st.top()] = a[i];\n            st.pop();\n        }\n        st.push(i);\n    }\n    return res;\n}\n"
      }
